rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================
    
    /// Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    /// Check if the authenticated user owns this resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    /// Check if user is blocked by another user
    function isBlocked(userId, byUserId) {
      return exists(/databases/$(database)/documents/users/$(byUserId)/blocked_users/$(userId));
    }
    
    /// Check if either user has blocked the other
    function hasBlockRelationship(userId1, userId2) {
      return isBlocked(userId1, userId2) || isBlocked(userId2, userId1);
    }
    
    /// Check rate limit for requests (10/hour, 30/day)
    function canSendRequest() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid)/rate_limits/connection_requests)
        || (request.time > get(/databases/$(database)/documents/users/$(request.auth.uid)/rate_limits/connection_requests).data.hourlyResetAt 
            || get(/databases/$(database)/documents/users/$(request.auth.uid)/rate_limits/connection_requests).data.hourlyCount < 10)
        && (request.time > get(/databases/$(database)/documents/users/$(request.auth.uid)/rate_limits/connection_requests).data.dailyResetAt 
            || get(/databases/$(database)/documents/users/$(request.auth.uid)/rate_limits/connection_requests).data.dailyCount < 30);
    }
    
    // ============================================================
    // USER PROFILES & DATA
    // ============================================================
    
    match /users/{userId} {
      // Privacy: keep `users` private (contains sensitive fields like email).
      // Other users should read public data from `/profiles/{userId}`.
      allow read: if isOwner(userId);
      
      // RULE: Only owner can create their profile
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['email', 'createdAt'])
        && request.resource.data.createdAt == request.time;
      
      // RULE: Only owner can update, but cannot change immutable fields
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['email', 'createdAt', 'uid']);
      
      // RULE: Users can delete their own profile
      allow delete: if isOwner(userId);
      
      // Rate limits subcollection - private to owner
      match /rate_limits/{limitId} {
        allow read, write: if isOwner(userId);
      }
      
      // Blocked users subcollection - private to owner
      match /blocked_users/{blockedId} {
        allow read, write: if isOwner(userId);
      }
      
      // User settings subcollection - private to owner
      match /settings/{document=**} {
        allow read, write: if isOwner(userId);
      }
      
      // Group memberships inverse index - for fast user groups query
      match /group_memberships/{groupId} {
        // RULE: Owner can read their own group memberships
        allow read: if isOwner(userId);
        
        // RULE: System can write group memberships (join/leave operations)
        // User must match the userId in the document
        allow create: if isAuthenticated()
          && request.resource.data.userId == userId
          && request.resource.data.groupId == groupId;
        
        // RULE: Allow updates for role changes
        allow update: if isAuthenticated()
          && request.resource.data.userId == userId;
        
        // RULE: Allow deletion when leaving groups
        allow delete: if isAuthenticated();
      }

      // Nearby Help saved locations subcollection
      match /locations/{locationType} {
        // RULE: Owner can read their own saved locations
        allow read: if isOwner(userId);
        
        // RULE: Owner can create/update their own saved locations
        allow create, update: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.type in ['home', 'work']
          && request.resource.data.latitude is number
          && request.resource.data.longitude is number;
        
        // RULE: Owner can delete their own saved locations
        allow delete: if isOwner(userId);
      }

      // Nearby Help locations subcollection (Firebase functions access)
      match /nearby_help_locations/{locationType} {
        // RULE: Owner can read their own saved locations
        allow read: if isOwner(userId);
        
        // RULE: Owner can create/update their own saved locations
        allow create, update: if isOwner(userId)
          && request.resource.data.latitude is number
          && request.resource.data.longitude is number;
        
        // RULE: Owner can delete their own saved locations
        allow delete: if isOwner(userId);
      }
    }
    
    // Public profiles (denormalized for faster reads)
    match /profiles/{userId} {
      // Anyone authenticated can read public profiles (if not blocked)
      allow read: if isAuthenticated() 
        && !hasBlockRelationship(request.auth.uid, userId);
      
      // RULE: Allow authenticated users to create their own profile
      // This is critical for first-time sign-up/sign-in flows
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.userId == userId;
      
      // RULE: Only owner can update their profile
      allow update: if isOwner(userId)
        || (isAuthenticated() 
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['isInGuessMeGame', 'guessMeSessionId', 'guessMeJoinedAt', 'isSearchingGuessMeGame', 'guessMeSearchStartedAt']));
      
      // RULE: Only owner can delete their profile
      allow delete: if isOwner(userId);

      // Proximity (private) - only the owner can read/write.
      match /proximity/{document=**} {
        allow read, write: if isOwner(userId);
      }

      // Stats (private) - only the owner can read/write.
      match /stats/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // ============================================================
    // PROXIMITY & NEARBY USERS
    // ============================================================
    
    // Username counter - atomic counter for generating unique usernames
    match /counters/usernames {
      // RULE: Any authenticated user can read the counter
      allow read: if isAuthenticated();
      
      // RULE: Any authenticated user can write (increment) the counter
      // The transaction ensures atomicity
      allow write: if isAuthenticated();
    }
    
    // Username index - maps usernames to user IDs for BLE discovery
    match /username_index/{username} {
      // RULE: Any authenticated user can read to look up profiles
      allow read: if isAuthenticated();
      
      // RULE: Users can only create their own index entry
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      
      // RULE: Users cannot update or delete index entries
      // This prevents username hijacking
      allow update, delete: if false;
    }
    
    // ============================================================
    // CONNECTIONS
    // ============================================================
    
    match /connections/{connectionId} {
      // Helper: Check if user is one of the participants
      function isParticipant() {
        return isAuthenticated() 
          && (resource.data.userId1 == request.auth.uid 
              || resource.data.userId2 == request.auth.uid);
      }
      
      // Helper: Check if user will be a participant (for creates)
      function willBeParticipant() {
        return isAuthenticated()
          && (request.resource.data.userId1 == request.auth.uid 
              || request.resource.data.userId2 == request.auth.uid);
      }
      
      // Helper: Check if user is in the users array (for list queries)
      function isInUsersArray() {
        return isAuthenticated() && request.auth.uid in resource.data.users;
      }
      
      // RULE: Participants can read individual connections
      allow get: if isAuthenticated() && isParticipant();
      
      // RULE: Users can list connections where they are a participant (for array-contains queries)
      allow list: if isAuthenticated() && isInUsersArray();
      
      // RULE: Participants can create connections
      // This supports both manual connections and GuessMe conversions
      allow create: if isAuthenticated() 
        && willBeParticipant()
        && request.resource.data.keys().hasAll(['userId1', 'userId2', 'status', 'connectedAt', 'updatedAt', 'initiatedBy', 'canMessage', 'shareLocation'])
        && request.resource.data.userId1 != request.resource.data.userId2
        && request.resource.data.status in ['connected', 'blocked', 'disconnected']
        && (request.resource.data.initiatedBy == request.resource.data.userId1 
            || request.resource.data.initiatedBy == request.resource.data.userId2)
        && !hasBlockRelationship(request.resource.data.userId1, request.resource.data.userId2);
      
      // RULE: Only participants can update (but cannot change core user fields)
      // EXCEPTION: connectedAt and initiatedBy can change when reconnecting
      // (transitioning from disconnected/blocked to connected status)
      allow update: if isAuthenticated() 
        && isParticipant()
        && request.resource.data.userId1 == resource.data.userId1
        && request.resource.data.userId2 == resource.data.userId2
        && (
          // Normal updates: connectedAt and initiatedBy must stay the same
          (request.resource.data.connectedAt == resource.data.connectedAt
           && request.resource.data.initiatedBy == resource.data.initiatedBy)
          // Reconnection: allow changing these fields when transitioning to 'connected'
          // from 'disconnected' or 'blocked' status
          || (resource.data.status in ['disconnected', 'blocked']
              && request.resource.data.status == 'connected')
        );
      
      // RULE: Either participant can delete the connection
      allow delete: if isAuthenticated() && isParticipant();
    }
    
    // Connection requests
    match /connection_requests/{requestId} {
      // RULE: Sender and receiver can read
      allow read: if isAuthenticated() 
        && (request.auth.uid == resource.data.senderId 
            || request.auth.uid == resource.data.receiverId);
      
      // RULE: Create with restrictions - rate limiting, blocking, valid data
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.senderId
        && request.resource.data.senderId != request.resource.data.receiverId
        && request.resource.data.status == 'pending'
        && request.resource.data.sentAt == request.time
        && canSendRequest()
        && !hasBlockRelationship(request.resource.data.senderId, request.resource.data.receiverId);
      
      // RULE: Receiver can accept/reject, sender can cancel
      allow update: if isAuthenticated()
        && ((request.auth.uid == resource.data.receiverId 
             && resource.data.status == 'pending'
             && request.resource.data.status in ['accepted', 'rejected'])
            || (request.auth.uid == resource.data.senderId 
                && resource.data.status == 'pending'
                && request.resource.data.status == 'cancelled'))
        && (!('senderId' in request.resource.data.keys()) || request.resource.data.senderId == resource.data.senderId)
        && (!('receiverId' in request.resource.data.keys()) || request.resource.data.receiverId == resource.data.receiverId);
      
      // RULE: Sender can delete cancelled requests, receiver can delete rejected
      allow delete: if isAuthenticated()
        && ((request.auth.uid == resource.data.senderId && resource.data.status == 'cancelled')
            || (request.auth.uid == resource.data.receiverId && resource.data.status == 'rejected'));
    }
    
    // ============================================================
    // CHAT / CONVERSATIONS
    // ============================================================
    
    match /conversations/{conversationId} {
      /// Check if user is participant in this conversation
      function isChatParticipant() {
        return isAuthenticated() && request.auth.uid in resource.data.participantIds;
      }
      
      /// Check if user will be participant (for creates)
      function willBeChatParticipant() {
        return isAuthenticated() && request.auth.uid in request.resource.data.participantIds;
      }
      
      // RULE: Only participants can read conversations
      allow read: if isChatParticipant();
      
      // RULE: Create requires participant and exactly 2 users
      // For GuessMe conversions: connection may be created simultaneously
      // For manual chats: connection should exist (enforced by app logic)
      allow create: if willBeChatParticipant()
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantIds[0] != request.resource.data.participantIds[1]
        && !hasBlockRelationship(request.resource.data.participantIds[0], request.resource.data.participantIds[1])
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasAll(['id', 'participantIds', 'participantNames', 'createdAt', 'lastMessageAt']);
      
      // RULE: Participants can update (last message, unread counts, mute, archive)
      allow update: if isChatParticipant()
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['participantIds', 'createdAt']);
      
      // RULE: Participants can delete (or soft delete via update)
      // Allow deletion if document doesn't exist (already deleted) or user is participant
      allow delete: if isAuthenticated() && 
        (resource == null || request.auth.uid in resource.data.participantIds);
      
      // Messages subcollection
      match /messages/{messageId} {
        /// Check if user is in the parent conversation
        /// Uses exists() first to avoid failed-precondition errors
        function isConversationMember() {
          let conversationPath = /databases/$(database)/documents/conversations/$(conversationId);
          return exists(conversationPath) 
            && request.auth.uid in get(conversationPath).data.participantIds;
        }
        
        /// Check if user sent this message
        function isMessageSender() {
          return isAuthenticated() && request.auth.uid == resource.data.senderId;
        }
        
        // RULE: Only conversation participants can read messages (even if disconnected - for history)
        allow read: if isAuthenticated() && isConversationMember();
        
        // RULE: Only participants can send messages (app logic handles connection status checks)
        // Supports both text and media messages
        allow create: if isAuthenticated() 
          && isConversationMember()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasAll(['senderId', 'text', 'sentAt', 'type'])
          && request.resource.data.text.size() <= 5000 // Max message length
          && request.resource.data.type in ['text', 'image', 'audio', 'document', 'sticker', 'video'];
        
        // RULE: Sender can edit/delete, recipient can only mark as read/delivered
        // Participants can mark messages as deleted when clearing chat
        allow update: if isAuthenticated() && isConversationMember()
          && (isMessageSender() 
              || request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['status', 'deliveredAt', 'readAt'])
              || request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['isDeleted', 'text', 'mediaUrl']));
        
        // RULE: Only sender can delete their messages
        allow delete: if isMessageSender();
      }
      
      // Typing indicators subcollection
      match /typing/{typingUserId} {
        /// Check if user is in the parent conversation
        /// Uses exists() first to avoid failed-precondition errors
        function isConversationMember() {
          let conversationPath = /databases/$(database)/documents/conversations/$(conversationId);
          return exists(conversationPath) 
            && request.auth.uid in get(conversationPath).data.participantIds;
        }
        
        // RULE: Participants can read typing status
        allow read: if isAuthenticated() && isConversationMember();
        
        // RULE: Users can only write their own typing status
        allow write: if isOwner(typingUserId) && isConversationMember();
      }
    }
    
    // ============================================================
    // REPORTS & MODERATION
    // ============================================================
    
    match /reports/{reportId} {
      // RULE: Users can create reports against others
      allow create: if isAuthenticated()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reporterId != request.resource.data.reportedUserId
        && request.resource.data.keys().hasAll(['reporterId', 'reportedUserId', 'reason', 'createdAt'])
        && request.resource.data.createdAt == request.time;
      
      // RULE: Users can read their own submitted reports
      allow read: if isAuthenticated() && request.auth.uid == resource.data.reporterId;
      
      // RULE: No user updates or deletes - admin only
      allow update, delete: if false;
    }
    
    // ============================================================
    // GUESS ME - Anonymous Game-Based Chat
    // ============================================================
    
    // GuessMe matchmaking queue
    match /guess_me_queue/{queueId} {
      // RULE: Users can read to find matches
      allow read: if isAuthenticated();
      
      // RULE: Users can only create their own queue entry
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'joinedAt', 'nearbyUserIds']);
      
      // RULE: Users can update their own entry (extend timeout)
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      
      // RULE: Users can delete their own queue entry
      // Allow delete if queueId matches user's ID (even if doc doesn't exist)
      allow delete: if isAuthenticated()
        && (queueId == request.auth.uid 
            || (resource != null && resource.data.userId == request.auth.uid));
    }

    // GuessMe connection requests (for pending matchmaking)
    match /guessme_connection_requests/{requestId} {
      // RULE: Users can read their own requests
      allow read: if isAuthenticated() 
        && (resource.data.senderId == request.auth.uid 
            || resource.data.receiverId == request.auth.uid);
      
      // RULE: Users can create connection requests
      allow create: if isAuthenticated()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.keys().hasAll(['senderId', 'receiverId', 'expiresAt']);
      
      // RULE: Users can update their own requests
      allow update: if isAuthenticated() 
        && (resource.data.senderId == request.auth.uid 
            || resource.data.receiverId == request.auth.uid);
      
      // RULE: Users can delete their own requests
      allow delete: if isAuthenticated()
        && (resource.data.senderId == request.auth.uid 
            || resource.data.receiverId == request.auth.uid);
    }
    
    // GuessMe game sessions
    match /guess_me_sessions/{sessionId} {
      /// Helper function to check if authenticated user is a participant
      function isSessionParticipant() {
        return request.auth.uid == resource.data.player1Id 
          || request.auth.uid == resource.data.player2Id;
      }
      
      /// Helper function to check if authenticated user will be a participant (for creates)
      function willBeSessionParticipant() {
        return request.auth.uid == request.resource.data.player1Id 
          || request.auth.uid == request.resource.data.player2Id;
      }
      
      // RULE: Participants can read individual session documents
      allow get: if isAuthenticated() && isSessionParticipant();
      
      // RULE: Users can list/query ONLY their own sessions using where('players', 'array-contains', uid)
      // The query filter ensures users only see sessions they're part of
      allow list: if isAuthenticated()
        && request.query.limit <= 100; // Prevent excessive reads
      
      // RULE: Authenticated users can create sessions (matchmaking service)
      // Both players must exist and be different
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['id', 'players', 'player1Id', 'player2Id', 'status', 'createdAt', 'expiresAt'])
        && willBeSessionParticipant()
        && request.resource.data.player1Id != request.resource.data.player2Id
        && request.resource.data.players.size() == 2
        && request.resource.data.players.hasAll([request.resource.data.player1Id, request.resource.data.player2Id])
        && request.resource.data.status in ['active', 'waiting'];
      
      // RULE: Only participants can update session (guess checks, status changes)
      // Cannot change immutable fields (player IDs, creation time)
      allow update: if isAuthenticated() 
        && isSessionParticipant()
        && request.resource.data.player1Id == resource.data.player1Id
        && request.resource.data.player2Id == resource.data.player2Id
        && request.resource.data.players == resource.data.players
        && request.resource.data.createdAt == resource.data.createdAt;
      
      // RULE: No deletes - sessions expire naturally or are cleaned up by admin
      allow delete: if false;
      
      // GuessMe messages within a session (subcollection)
      match /messages/{messageId} {
        /// Check if user is participant in the parent session
        /// CRITICAL: Uses exists() check first to handle non-existent sessions gracefully
        function isSessionParticipant() {
          let sessionPath = /databases/$(database)/documents/guess_me_sessions/$(sessionId);
          return exists(sessionPath) 
            && (
              request.auth.uid == get(sessionPath).data.player1Id 
              || request.auth.uid == get(sessionPath).data.player2Id
            );
        }
        
        // RULE: Only session participants can read messages
        // This allows reading ALL messages in the session, including system messages
        allow read: if isAuthenticated() && isSessionParticipant();
        
        // RULE: Only session participants can send messages
        // System messages (senderId == 'system') can be sent by any participant
        // User messages must have senderId matching the authenticated user
        allow create: if isAuthenticated()
          && isSessionParticipant()
          && (request.resource.data.senderId == request.auth.uid 
              || request.resource.data.senderId == 'system')
          && request.resource.data.keys().hasAll(['id', 'sessionId', 'senderId', 'text', 'sentAt', 'type'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000;
        
        // RULE: No updates or deletes - messages are immutable
        allow update, delete: if false;
      }
    }
    
    // GuessMe messages are now stored as subcollections under guess_me_sessions/{sessionId}/messages
    // This provides better permission handling and matches the pattern used by conversations
    // Legacy top-level collection (deprecated - messages now in subcollection)
    match /guess_me_messages/{messageId} {
      // Deny all access - messages should be in subcollection
      allow read, write: if false;
    }
    
    // GuessMe user stats - stored under profiles/{userId}/stats/guessme for privacy
    // Access is controlled by the profiles/{userId}/stats/** rule

    // GuessMe sessions (alternative structure using players array)
    match /guessme_sessions/{sessionId} {
      // RULE: Only participants can read their session
      allow read: if isAuthenticated() 
        && request.auth != null
        && request.auth.uid in resource.data.players;
      
      // RULE: Only participants can create sessions
      allow create: if isAuthenticated()
        && request.auth != null
        && request.auth.uid in request.resource.data.players
        && request.resource.data.keys().hasAll(['players', 'status', 'createdAt']);
      
      // RULE: Only participants can update session
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.players;
      
      // RULE: No deletes - sessions expire naturally
      allow delete: if false;
    }
    
    // ============================================================
    // COLLECTION GROUP RULES (for cross-collection queries)
    // ============================================================
    
    // CRITICAL: Collection group queries require rules at the wildcard path level.
    // The path {path=**}/members/{memberId} matches 'members' subcollections
    // under ANY parent document, enabling collectionGroup('members') queries.
    //
    // This rule allows users to:
    // 1. Query their own memberships across all groups (for "My Groups" feature)
    // 2. Read their own membership document in any group
    match /{path=**}/members/{memberId} {
      // Users can read/list their own membership documents across all groups
      // This is required for collectionGroup('members').where('userId', '==', uid)
      allow read: if request.auth != null 
        && resource.data.userId == request.auth.uid;
    }
    
    // ============================================================
    // NEARBY GROUPS (Bluetooth-based proximity)
    // ============================================================
    
    match /nearby_groups/{groupId} {
      /// Check if user is the creator of this group
      function isNearbyGroupCreator() {
        return resource.data.creatorId == request.auth.uid;
      }
      
      /// Check if user is a member of this nearby group (detected via Bluetooth)
      function isNearbyGroupMember() {
        return exists(/databases/$(database)/documents/nearby_groups/$(groupId)/members/$(request.auth.uid));
      }
      
      // RULE: Any authenticated user can read active nearby groups (for discovery)
      allow read: if isAuthenticated();
      
      // RULE: Users can create ONE nearby group at a time
      // The app must enforce this client-side by closing existing groups first
      allow create: if isAuthenticated()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 50
        && request.resource.data.creatorUsername is string
        && request.resource.data.memberCount == 1;
      
      // RULE: Only creator can update group (for status changes, heartbeat)
      // Exception: Members can update message activity fields when sending messages
      allow update: if isAuthenticated()
        && (
          // Creator path: full updates (no immutable field changes)
          (isNearbyGroupCreator()
           && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['creatorId', 'createdAt']))
          // Message activity path: members can update message preview and timestamps
          // Required for sendMessage to update group metadata
          || (isNearbyGroupMember()
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['lastMessagePreview', 'lastMessageAt', 'lastActiveAt']))
        );
      
      // RULE: Only creator can delete their group
      allow delete: if isAuthenticated() && isNearbyGroupCreator();
      
      // Members subcollection (managed by creator via Bluetooth detection)
      match /members/{memberId} {
        // RULE: Any authenticated user can read members (for UI display)
        allow read: if isAuthenticated();
        
        // RULE: Only creator can manage members (add/remove based on Bluetooth)
        // Special case: Allow user to add themselves as first member during batch group creation
        // (when parent doc doesn't exist yet in the batch)
        allow create: if isAuthenticated()
          && request.resource.data.userId == memberId
          && (
            // Case 1: Adding self during initial group creation (batch write)
            memberId == request.auth.uid
            // Case 2: Creator adding other members after group exists
            || get(/databases/$(database)/documents/nearby_groups/$(groupId)).data.creatorId == request.auth.uid
          );
        
        // RULE: Only creator can update members
        allow update: if isAuthenticated()
          && get(/databases/$(database)/documents/nearby_groups/$(groupId)).data.creatorId == request.auth.uid
          && request.resource.data.userId == memberId;
        
        // RULE: Creator can remove members, or members can remove themselves
        allow delete: if isAuthenticated()
          && (get(/databases/$(database)/documents/nearby_groups/$(groupId)).data.creatorId == request.auth.uid
              || memberId == request.auth.uid);
      }
      
      // Messages subcollection (open chatroom model)
      match /messages/{messageId} {
        // RULE: Only members can read messages
        allow read: if isAuthenticated() && isNearbyGroupMember();
        
        // RULE: Only members can send messages
        allow create: if isAuthenticated()
          && isNearbyGroupMember()
          && (
            // Regular text messages from members
            (request.resource.data.senderId == request.auth.uid
             && request.resource.data.type != 'system')
            // System messages: sent by members for join/leave notifications
            || (request.resource.data.senderId == null
                && request.resource.data.type == 'system')
          )
          && request.resource.data.groupId == groupId
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000;
        
        // RULE: Senders can delete their own messages, creator can delete any
        allow update: if isAuthenticated()
          && (resource.data.senderId == request.auth.uid 
              || get(/databases/$(database)/documents/nearby_groups/$(groupId)).data.creatorId == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDeleted']);
        
        // RULE: Creator can hard delete messages (for group deletion)
        allow delete: if isAuthenticated()
          && get(/databases/$(database)/documents/nearby_groups/$(groupId)).data.creatorId == request.auth.uid;
      }
    }
    
    // ============================================================
    // LOCATION GROUPS
    // ============================================================
    
    match /location_groups/{groupId} {
      /// Check if user is a member of this group
      function isGroupMember() {
        // IMPORTANT: This function reads the caller's membership document.
        // The members/{uid} rule must allow the caller to read their own doc,
        // otherwise list queries can fail with PERMISSION_DENIED.
        return exists(/databases/$(database)/documents/location_groups/$(groupId)/members/$(request.auth.uid))
          && get(/databases/$(database)/documents/location_groups/$(groupId)/members/$(request.auth.uid)).data.status == 'active';
      }
      
      /// Check if user is an admin of this group
      function isGroupAdmin() {
        return exists(/databases/$(database)/documents/location_groups/$(groupId)/members/$(request.auth.uid))
          && get(/databases/$(database)/documents/location_groups/$(groupId)/members/$(request.auth.uid)).data.status == 'active'
          && get(/databases/$(database)/documents/location_groups/$(groupId)/members/$(request.auth.uid)).data.role == 'admin';
      }
      
      // RULE: Any authenticated user can read groups (for discovery)
      allow read: if isAuthenticated();
      
      // RULE: Any authenticated user can create a group
      allow create: if isAuthenticated()
        && request.resource.data.createdByUserId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.memberCount == 1
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.countryCode is string
        && request.resource.data.stateCode is string
        && request.resource.data.visibility in ['public', 'requestToJoin'];
      
      // RULE: Only admins can update group settings
      // NOTE: Allow memberCount and updatedAt adjustments for join/leave operations
      allow update: if isAuthenticated()
        && (
          (
            // Admin path: full settings updates (no immutable field changes)
            isGroupAdmin()
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['createdByUserId', 'createdAt', 'countryCode', 'stateCode'])
          )
          || (
            // Member join/leave path: only memberCount ±1 and updatedAt
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'updatedAt'])
            && (
              request.resource.data.memberCount == resource.data.memberCount + 1
              || request.resource.data.memberCount == resource.data.memberCount - 1
            )
          )
          || (
            // Message activity path: lastActivityAt and lastMessagePreview updates
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActivityAt', 'lastMessagePreview'])
          )
        );
      
      // RULE: Only admins can delete (archive) groups
      allow delete: if isAuthenticated() && isGroupAdmin();
      
      // Members subcollection
      match /members/{memberId} {
        // RULE: Users can ALWAYS read their own membership doc
        // This must not call isGroupMember() to avoid circular dependency
        // Other members can be read if the requesting user is an active member
        allow get: if isAuthenticated() 
          && (
            memberId == request.auth.uid  // User reading their own doc
            || isGroupMember()  // Active member reading other members
          );
        
        // RULE: Allow listing members - either for collectionGroup queries
        // (filtered by userId on client) or for viewing group member lists
        allow list: if isAuthenticated();
        
        // RULE: User can create themselves as a member in these cases:
        // 1. Creating group (as admin with active status)
        // 2. Joining public group (as member with active status)  
        // 3. Requesting to join private group (as member with pending status)
        // 4. Admin approving a join request (creating member for another user)
        allow create: if isAuthenticated()
          && (
            // Cases 1-3: User creating their own membership
            (memberId == request.auth.uid
             && request.resource.data.userId == request.auth.uid
             && (
               // Case 1: Group creator adding themselves as admin (group may not exist yet in batch)
               (request.resource.data.role == 'admin' 
                && request.resource.data.status == 'active')
               // Case 2 & 3: Regular member joining or requesting
               || (!exists(/databases/$(database)/documents/location_groups/$(groupId))
                   || get(/databases/$(database)/documents/location_groups/$(groupId)).data.visibility == 'public'
                   || request.resource.data.status == 'pending')
             ))
            // Case 4: Admin approving a join request
            || (isGroupAdmin()
                && request.resource.data.userId == memberId
                && request.resource.data.status == 'active'
                && request.resource.data.role == 'member'
                && exists(/databases/$(database)/documents/location_groups/$(groupId)/join_requests/$(memberId)))
          );
        
        // RULE: Admins can update any member (for promotion, ban)
        // Users can update their own membership (for leaving, marking read)
        // CRITICAL: Active group members can update message-related fields 
        // (unreadCount, lastReadAt, updatedAt) on ANY member document.
        // This is required for message sending to work correctly - when a user
        // sends a message, they need to increment unreadCount for all other members.
        allow update: if isAuthenticated()
          && (
            // Admin full update: can change any fields
            isGroupAdmin() 
            // Self update: member can update their own document
            || memberId == request.auth.uid
            // Message-related updates: any group member can update message tracking fields
            // This allows sendMessage to update unreadCount for all members
            || (isGroupMember() 
                && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['unreadCount', 'lastReadAt', 'updatedAt']))
          );
        
        // RULE: Admins can remove members, users can remove themselves
        allow delete: if isAuthenticated()
          && (isGroupAdmin() || memberId == request.auth.uid);
      }
      
      // Join requests subcollection (for private groups)
      match /join_requests/{requestId} {
        // RULE: Admins can read join requests
        allow read: if isAuthenticated() 
          && (isGroupAdmin() || requestId == request.auth.uid);
        
        // RULE: Users can create join requests for themselves
        allow create: if isAuthenticated()
          && requestId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'pending';
        
        // RULE: Admins can update requests (approve/reject)
        allow update: if isAuthenticated() && isGroupAdmin();
        
        // RULE: Admins can delete requests, users can cancel their own
        allow delete: if isAuthenticated()
          && (isGroupAdmin() || requestId == request.auth.uid);
      }
      
      // Messages subcollection
      match /messages/{messageId} {
        // RULE: Only members can read messages
        allow read: if isAuthenticated() && isGroupMember();
        
        // RULE: Only members can send messages
        // Allow both user messages (senderId = auth.uid) and system messages (senderId = 'system')
        allow create: if isAuthenticated()
          && isGroupMember()
          && (
            // User messages: sender must be authenticated user
            (request.resource.data.senderId == request.auth.uid
             && request.resource.data.type != 'system')
            // System messages: sent by members for join/leave notifications
            || (request.resource.data.senderId == 'system'
                && request.resource.data.type == 'system')
          )
          && request.resource.data.groupId == groupId
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000
          && request.resource.data.isDeleted == false;
        
        // RULE: Senders can delete (soft delete) their own messages, admins can delete any
        allow update: if isAuthenticated()
          && (resource.data.senderId == request.auth.uid || isGroupAdmin())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDeleted']);
        
        // RULE: No hard deletes
        allow delete: if false;
      }
    }
    
    // ============================================================
    // RANDOM GROUPS (Admin-approved internet-based groups)
    // ============================================================
    
    // Collection group rule for querying members across all random_groups
    // This enables the watchUserMemberships() collection group query
    match /{path=**}/members/{memberId} {
      // RULE: Any authenticated user can read members via collection group query
      // This is needed for efficient "my groups" lookup
      allow read: if isAuthenticated();
    }
    
    match /random_groups/{groupId} {
      /// Check if user is the creator of this group
      function isRandomGroupCreator() {
        return resource.data.creatorId == request.auth.uid;
      }
      
      /// Check if user is an admin of this random group
      function isRandomGroupAdmin() {
        return request.auth.uid in resource.data.adminIds;
      }
      
      /// Check if user is a member of this random group
      function isRandomGroupMember() {
        return exists(/databases/$(database)/documents/random_groups/$(groupId)/members/$(request.auth.uid));
      }
      
      // RULE: Any authenticated user can read active random groups (for discovery)
      allow read: if isAuthenticated();
      
      // RULE: Users can create random groups
      allow create: if isAuthenticated()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.memberCount == 1
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 50
        && request.auth.uid in request.resource.data.adminIds;
      
      // RULE: Only admins can update group settings
      // Allow non-admins to increment pendingRequestCount when creating join requests
      // Allow members to update message activity fields when sending messages
      allow update: if isAuthenticated()
        && (
          // Admin path: full settings updates (no immutable field changes)
          (isRandomGroupAdmin()
           && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['creatorId', 'createdAt']))
          // Non-admin path: only pendingRequestCount updates (increment by 1)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingRequestCount'])
              && (request.resource.data.pendingRequestCount == resource.data.pendingRequestCount + 1
                  || request.resource.data.pendingRequestCount == resource.data.pendingRequestCount - 1))
          // Message activity path: members can update message preview and timestamps
          // Required for sendMessage to update group metadata
          || (isRandomGroupMember()
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['lastMessagePreview', 'lastMessageAt', 'lastActiveAt']))
        );
      
      // RULE: Only creator can delete (soft delete via status change)
      allow delete: if isAuthenticated() && isRandomGroupCreator();
      
      // Members subcollection
      match /members/{memberId} {
        // RULE: Any authenticated user can read members
        allow read: if isAuthenticated();
        
        // RULE: Creator auto-adds themselves, or admins add approved members
        allow create: if isAuthenticated()
          && request.resource.data.userId == memberId
          && (
            // Creator adding themselves during group creation (batch write)
            // During batch, group may not exist yet, so we check if memberId matches auth uid
            // and the member is marked as admin (creator is always admin)
            (memberId == request.auth.uid && request.resource.data.isAdmin == true)
            // Admin adding approved member (group exists)
            || (exists(/databases/$(database)/documents/random_groups/$(groupId))
                && request.auth.uid in get(/databases/$(database)/documents/random_groups/$(groupId)).data.adminIds)
          );
        
        // RULE: Admins can update any member, members can update their own document
        // Self-update is needed for marking messages as read (lastReadAt, updatedAt)
        allow update: if isAuthenticated()
          && (
            // Admin full update: can change any fields
            request.auth.uid in get(/databases/$(database)/documents/random_groups/$(groupId)).data.adminIds
            // Self update: member can update their own document (for marking read)
            || memberId == request.auth.uid
          );
        
        // RULE: Admins can remove members (except creator), members can leave
        allow delete: if isAuthenticated()
          && (
            // Member leaving on their own
            (memberId == request.auth.uid 
              && get(/databases/$(database)/documents/random_groups/$(groupId)).data.creatorId != request.auth.uid)
            // Admin removing member (not creator)
            || (request.auth.uid in get(/databases/$(database)/documents/random_groups/$(groupId)).data.adminIds
                && get(/databases/$(database)/documents/random_groups/$(groupId)).data.creatorId != memberId)
          );
      }
      
      // Join requests subcollection
      match /join_requests/{requestId} {
        // RULE: Admins can read all requests, users can read their own
        allow read: if isAuthenticated()
          && (request.auth.uid in get(/databases/$(database)/documents/random_groups/$(groupId)).data.adminIds
              || resource.data.requesterId == request.auth.uid);
        
        // RULE: Any authenticated user can create a join request
        allow create: if isAuthenticated()
          && request.resource.data.requesterId == request.auth.uid
          && request.resource.data.groupId == groupId
          && request.resource.data.status == 'pending';
        
        // RULE: Only admins can update requests (approve/reject)
        allow update: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/random_groups/$(groupId)).data.adminIds
          && request.resource.data.status in ['approved', 'rejected']
          && resource.data.status == 'pending';
        
        // RULE: No deletes - keep request history
        allow delete: if false;
      }
      
      // Messages subcollection
      match /messages/{messageId} {
        // RULE: Only members can read messages
        allow read: if isAuthenticated() && isRandomGroupMember();
        
        // RULE: Only members can send messages
        allow create: if isAuthenticated()
          && isRandomGroupMember()
          && (
            // Regular text messages from members
            (request.resource.data.senderId == request.auth.uid
             && request.resource.data.type != 'system')
            // System messages: sent by members for join/leave notifications
            // Any member can send system messages (e.g., when leaving the group)
            || (request.resource.data.senderId == null
                && request.resource.data.type == 'system')
          )
          && request.resource.data.groupId == groupId
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000;
        
        // RULE: Senders can delete their own messages, admins can delete any
        allow update: if false; // No edits
        
        // RULE: Senders can delete their own, admins can delete any
        allow delete: if isAuthenticated()
          && (resource.data.senderId == request.auth.uid 
              || request.auth.uid in get(/databases/$(database)/documents/random_groups/$(groupId)).data.adminIds);
      }
    }
    
    // ============================================================
    // DEVICE SESSIONS (Security & Debugging)
    // ============================================================
    
    match /device_sessions/{sessionId} {
      // RULE: Users can only read their own device sessions
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // RULE: System creates device sessions during login/register
      // Users can create their own session records
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['sessionId', 'userId', 'timestamp', 'sessionType'])
        && request.resource.data.sessionType in ['login', 'register'];
      
      // RULE: No updates or deletes from clients - data integrity for security logs
      allow update, delete: if false;
    }
    
    // ============================================================
    // APP CONFIGURATION (read-only)
    // ============================================================
    
    match /appConfig/{document=**} {
      // RULE: Any authenticated user can read app config
      allow read: if isAuthenticated();
      
      // RULE: No client writes - admin SDK only
      allow write: if false;
    }

    // ============================================================
    // NEARBY HELP REQUESTS
    // ============================================================
    
    match /help_requests/{requestId} {
      // Helper: Check if user is the seeker
      function isSeeker() {
        return isAuthenticated() && resource.data.seekerUserId == request.auth.uid;
      }
      
      // Helper: Check if user is the assigned helper
      function isHelper() {
        return isAuthenticated() && resource.data.helperUserId == request.auth.uid;
      }
      
      // Helper: Check if user will be the seeker (for creates)
      function willBeSeeker() {
        return isAuthenticated() && request.resource.data.seekerUserId == request.auth.uid;
      }
      
      // RULE: Authenticated users can read any help request
      // This is needed for helpers to view requests they might accept
      allow read: if isAuthenticated();
      
      // RULE: Users can create help requests for themselves
      allow create: if isAuthenticated()
        && willBeSeeker()
        && request.resource.data.keys().hasAll(['seekerUserId', 'seekerName', 'latitude', 'longitude', 'radius', 'status', 'expiresAt'])
        && request.resource.data.status == 'OPEN'
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.radius in [50, 100, 500, 1000, 2000]
        && (!('helperUserId' in request.resource.data.keys()) || request.resource.data.helperUserId == null);
      
      // RULE: Seeker can update their own request (cancel, mark completed)
      // Helper can update request (accept, mark on the way, mark completed)
      allow update: if isAuthenticated()
        && (
          // Seeker can cancel their own request
          (isSeeker() && request.resource.data.status in ['CANCELLED', 'RESOLVED'])
          // Helper can accept an open request (atomic assignment)
          || (resource.data.status == 'OPEN' 
              && request.resource.data.status == 'IN_PROGRESS'
              && request.resource.data.helperUserId == request.auth.uid
              && request.resource.data.helperName is string)
          // Assigned helper can update status
          || (isHelper() && request.resource.data.status in ['IN_PROGRESS', 'RESOLVED'])
        )
        // Cannot change seeker fields
        && request.resource.data.seekerUserId == resource.data.seekerUserId
        && request.resource.data.latitude == resource.data.latitude
        && request.resource.data.longitude == resource.data.longitude;
      
      // RULE: Only seeker can delete their own request (soft delete via status change preferred)
      allow delete: if isSeeker();
    }
  }
}
