rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================
    
    /// Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    /// Check if the authenticated user owns this resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    /// Check if user is blocked by another user
    function isBlocked(userId, byUserId) {
      return exists(/databases/$(database)/documents/users/$(byUserId)/blocked_users/$(userId));
    }
    
    /// Check if either user has blocked the other
    function hasBlockRelationship(userId1, userId2) {
      return isBlocked(userId1, userId2) || isBlocked(userId2, userId1);
    }
    
    /// Check if two users are connected (accepted connection)
    function areConnected(userId1, userId2) {
      let connectionId = userId1 < userId2 
        ? userId1 + '_' + userId2 
        : userId2 + '_' + userId1;
      return exists(/databases/$(database)/documents/connections/$(connectionId))
        && get(/databases/$(database)/documents/connections/$(connectionId)).data.status == 'connected';
    }
    
    /// Check if user is participant in connection
    function isConnectionParticipant() {
      return isAuthenticated() && request.auth.uid in resource.data.users;
    }
    
    /// Check rate limit for requests (10/hour, 30/day)
    function canSendRequest() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid)/rate_limits/connection_requests)
        || (request.time > get(/databases/$(database)/documents/users/$(request.auth.uid)/rate_limits/connection_requests).data.hourlyResetAt 
            || get(/databases/$(database)/documents/users/$(request.auth.uid)/rate_limits/connection_requests).data.hourlyCount < 10)
        && (request.time > get(/databases/$(database)/documents/users/$(request.auth.uid)/rate_limits/connection_requests).data.dailyResetAt 
            || get(/databases/$(database)/documents/users/$(request.auth.uid)/rate_limits/connection_requests).data.dailyCount < 30);
    }
    
    // ============================================================
    // USER PROFILES & DATA
    // ============================================================
    
    match /users/{userId} {
      // Privacy: keep `users` private (contains sensitive fields like email).
      // Other users should read public data from `/profiles/{userId}`.
      allow read: if isOwner(userId);
      
      // RULE: Only owner can create their profile
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['email', 'createdAt'])
        && request.resource.data.createdAt == request.time;
      
      // RULE: Only owner can update, but cannot change immutable fields
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['email', 'createdAt', 'uid']);
      
      // RULE: Users can delete their own profile
      allow delete: if isOwner(userId);
      
      // Rate limits subcollection - private to owner
      match /rate_limits/{limitId} {
        allow read, write: if isOwner(userId);
      }
      
      // Blocked users subcollection - private to owner
      match /blocked_users/{blockedId} {
        allow read, write: if isOwner(userId);
      }
      
      // User settings subcollection - private to owner
      match /settings/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Public profiles (denormalized for faster reads)
    match /profiles/{userId} {
      // Anyone authenticated can read public profiles (if not blocked)
      allow read: if isAuthenticated() 
        && !hasBlockRelationship(request.auth.uid, userId);
      
      // Only owner can write their profile
      allow write: if isOwner(userId);

      // Proximity (private) - only the owner can read/write.
      match /proximity/{document=**} {
        allow read, write: if isOwner(userId);
      }

      // Stats (private) - only the owner can read/write.
      match /stats/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // ============================================================
    // PROXIMITY & NEARBY USERS
    // ============================================================
    
    // Username counter - atomic counter for generating unique usernames
    match /counters/usernames {
      // RULE: Any authenticated user can read the counter
      allow read: if isAuthenticated();
      
      // RULE: Any authenticated user can write (increment) the counter
      // The transaction ensures atomicity
      allow write: if isAuthenticated();
    }
    
    // Username index - maps usernames to user IDs for BLE discovery
    match /username_index/{username} {
      // RULE: Any authenticated user can read to look up profiles
      allow read: if isAuthenticated();
      
      // RULE: Users can only create their own index entry
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      
      // RULE: Users cannot update or delete index entries
      // This prevents username hijacking
      allow update, delete: if false;
    }
    
    // BLE ID mappings - maps Bluetooth IDs to user IDs (legacy, may be deprecated)
    match /ble_id_mappings/{mappingId} {
      // RULE: Any authenticated user can fetch a specific mapping (doc-get)
      // only if it is still valid and the owner is currently discoverable.
      // Privacy: deny collection enumeration to reduce linkability/harvesting risk.
      allow get: if isAuthenticated()
        && resource.data.bleToken is string
        && resource.data.bleToken == mappingId
        && resource.data.bleToken.size() == 64
        && resource.data.userId is string
        && resource.data.isVisible is bool
        && resource.data.expiresAt is timestamp
        && resource.data.expiresAt > request.time
        && resource.data.isVisible == true;
      allow list: if false;
      
      // RULE: Users can only create their own mapping.
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.userId
        // Only allow the minimal expected schema.
        && request.resource.data.keys().hasOnly(['bleToken', 'userId', 'expiresAt', 'updatedAt', 'isVisible'])
        && request.resource.data.bleToken is string
        && request.resource.data.bleToken == mappingId
        // sha256 hex
        && request.resource.data.bleToken.size() == 64
        && request.resource.data.userId is string
        && request.resource.data.isVisible is bool
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        // Bound TTL to prevent abuse / long-lived linkability.
        && request.resource.data.expiresAt < request.time + duration.value(30, 'm');

      // RULE: Users can only extend/refresh expiry on their existing mapping.
      // Prevent rewriting bleId->userId association once created.
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.userId
        && request.resource.data.keys().hasOnly(['bleToken', 'userId', 'expiresAt', 'updatedAt', 'isVisible'])
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.bleToken == resource.data.bleToken
        && request.resource.data.bleToken == mappingId
        // Updates may only touch expiry + updatedAt + discoverability.
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiresAt', 'updatedAt', 'isVisible'])
        && request.resource.data.isVisible is bool
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(30, 'm');
      
      // RULE: Users can delete their own mapping
      allow delete: if isAuthenticated() 
        && request.auth.uid == resource.data.userId;
    }
    
    // Proximity beacons - users broadcast their presence
    match /proximityBeacons/{beaconId} {
      // RULE: Any authenticated user can read beacons (filtered by distance client-side)
      allow read: if isAuthenticated();
      
      // RULE: Only owner can write their beacon
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'location', 'timestamp']);
      
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      
      allow delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }
    
    // Encounters - records of nearby user detections
    match /encounters/{encounterId} {
      // RULE: Users can read encounters they participated in
      allow read: if isAuthenticated() 
        && request.auth.uid in resource.data.userIds;
      
      // RULE: Users can create encounters they're part of
      allow create: if isAuthenticated() 
        && request.auth.uid in request.resource.data.userIds
        && request.resource.data.userIds.size() == 2;
      
      // No updates or deletes - encounters are immutable records
      allow update, delete: if false;
    }
    
    // ============================================================
    // CONNECTIONS
    // ============================================================
    
    match /connections/{connectionId} {
      // RULE: Only participants can read their connections
      allow read: if isAuthenticated() && isConnectionParticipant();
      
      // RULE: Participants can create connections (via accepting request)
      allow create: if isAuthenticated() 
        && request.auth.uid in request.resource.data.users
        && request.resource.data.users.size() == 2
        && request.resource.data.status == 'connected'
        && !hasBlockRelationship(request.resource.data.users[0], request.resource.data.users[1]);
      
      // RULE: Only participants can update (but cannot change core fields)
      allow update: if isAuthenticated() 
        && isConnectionParticipant()
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['users', 'createdAt']);
      
      // RULE: Either participant can delete the connection
      allow delete: if isAuthenticated() && isConnectionParticipant();
    }
    
    // Connection requests
    match /connection_requests/{requestId} {
      // RULE: Sender and receiver can read
      allow read: if isAuthenticated() 
        && (request.auth.uid == resource.data.senderId 
            || request.auth.uid == resource.data.receiverId);
      
      // RULE: Create with restrictions - rate limiting, blocking, valid data
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.senderId
        && request.resource.data.senderId != request.resource.data.receiverId
        && request.resource.data.status == 'pending'
        && request.resource.data.sentAt == request.time
        && canSendRequest()
        && !hasBlockRelationship(request.resource.data.senderId, request.resource.data.receiverId);
      
      // RULE: Receiver can accept/reject, sender can cancel
      allow update: if isAuthenticated()
        && ((request.auth.uid == resource.data.receiverId 
             && resource.data.status == 'pending'
             && request.resource.data.status in ['accepted', 'rejected'])
            || (request.auth.uid == resource.data.senderId 
                && resource.data.status == 'pending'
                && request.resource.data.status == 'cancelled'))
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.receiverId == resource.data.receiverId;
      
      // RULE: Sender can delete cancelled requests, receiver can delete rejected
      allow delete: if isAuthenticated()
        && ((request.auth.uid == resource.data.senderId && resource.data.status == 'cancelled')
            || (request.auth.uid == resource.data.receiverId && resource.data.status == 'rejected'));
    }
    
    // ============================================================
    // CHAT / CONVERSATIONS
    // ============================================================
    
    match /conversations/{conversationId} {
      /// Check if user is participant in this conversation
      function isChatParticipant() {
        return isAuthenticated() && request.auth.uid in resource.data.participantIds;
      }
      
      /// Check if user will be participant (for creates)
      function willBeChatParticipant() {
        return isAuthenticated() && request.auth.uid in request.resource.data.participantIds;
      }
      
      // RULE: Only participants can read conversations
      allow read: if isChatParticipant();
      
      // RULE: Create requires: participant, exactly 2 users, users are connected, not blocked
      allow create: if willBeChatParticipant()
        && request.resource.data.participantIds.size() == 2
        && areConnected(request.resource.data.participantIds[0], request.resource.data.participantIds[1])
        && !hasBlockRelationship(request.resource.data.participantIds[0], request.resource.data.participantIds[1])
        && request.resource.data.createdAt == request.time;
      
      // RULE: Participants can update (last message, unread counts, mute, archive)
      allow update: if isChatParticipant()
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['participantIds', 'createdAt']);
      
      // RULE: Participants can delete (or soft delete via update)
      allow delete: if isChatParticipant();
      
      // Messages subcollection
      match /messages/{messageId} {
        /// Check if user is in the parent conversation
        function isConversationMember() {
          let conversation = get(/databases/$(database)/documents/conversations/$(conversationId));
          return request.auth.uid in conversation.data.participantIds;
        }
        
        /// Check if user sent this message
        function isMessageSender() {
          return isAuthenticated() && request.auth.uid == resource.data.senderId;
        }
        
        // RULE: Only conversation participants can read messages
        allow read: if isAuthenticated() && isConversationMember();
        
        // RULE: Only participants can send, sender must be authenticated user
        allow create: if isAuthenticated() 
          && isConversationMember()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasAll(['senderId', 'text', 'sentAt'])
          && request.resource.data.text.size() <= 5000; // Max message length
        
        // RULE: Sender can edit/delete, recipient can only mark as read/delivered
        allow update: if isAuthenticated() && isConversationMember()
          && (isMessageSender() 
              || request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['status', 'deliveredAt', 'readAt']));
        
        // RULE: Only sender can delete their messages
        allow delete: if isMessageSender();
      }
      
      // Typing indicators subcollection
      match /typing/{typingUserId} {
        /// Check if user is in the parent conversation
        function isConversationMember() {
          let conversation = get(/databases/$(database)/documents/conversations/$(conversationId));
          return request.auth.uid in conversation.data.participantIds;
        }
        
        // RULE: Participants can read typing status
        allow read: if isAuthenticated() && isConversationMember();
        
        // RULE: Users can only write their own typing status
        allow write: if isOwner(typingUserId) && isConversationMember();
      }
    }
    
    // ============================================================
    // REPORTS & MODERATION
    // ============================================================
    
    match /reports/{reportId} {
      // RULE: Users can create reports against others
      allow create: if isAuthenticated()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reporterId != request.resource.data.reportedUserId
        && request.resource.data.keys().hasAll(['reporterId', 'reportedUserId', 'reason', 'createdAt'])
        && request.resource.data.createdAt == request.time;
      
      // RULE: Users can read their own submitted reports
      allow read: if isAuthenticated() && request.auth.uid == resource.data.reporterId;
      
      // RULE: No user updates or deletes - admin only
      allow update, delete: if false;
    }
    
    // ============================================================
    // APP CONFIGURATION (read-only)
    // ============================================================
    
    match /appConfig/{document=**} {
      // RULE: Any authenticated user can read app config
      allow read: if isAuthenticated();
      
      // RULE: No client writes - admin SDK only
      allow write: if false;
    }
  }
}
