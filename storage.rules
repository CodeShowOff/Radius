rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================
    
    /// Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    /// Check if the authenticated user is a participant in the conversation.
    /// Uses a cross-service Firestore read to verify membership.
    function isConversationParticipant(conversationId) {
      return isAuthenticated()
        && request.auth.uid in firestore.get(
          /databases/(default)/documents/conversations/$(conversationId)
        ).data.participantIds;
    }
    
    /// Check if file size is within limit (20MB for images, 100MB for docs)
    function isValidSize(maxSizeMB) {
      return request.resource.size <= maxSizeMB * 1024 * 1024;
    }
    
    /// Check if file is an image
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    
    /// Check if file is audio
    function isAudio() {
      return request.resource.contentType.matches('audio/.*');
    }
    
    /// Check if file is a document
    function isDocument() {
      return request.resource.contentType in [
        'application/pdf',
        'application/msword',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
        'application/vnd.ms-excel',
        'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
        'text/plain'
      ];
    }
    
    /// Check if file is a video
    function isVideo() {
      return request.resource.contentType.matches('video/.*');
    }
    
    /// Check if user is a member of a location group.
    /// Uses a cross-service Firestore read to verify membership.
    function isLocationGroupMember(groupId) {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/location_groups/$(groupId)/members/$(request.auth.uid))
        && firestore.get(
          /databases/(default)/documents/location_groups/$(groupId)/members/$(request.auth.uid)
        ).data.status == 'active';
    }
    
    /// Check if user is a member of a random group.
    function isRandomGroupMember(groupId) {
      return isAuthenticated()
        && request.auth.uid in firestore.get(
          /databases/(default)/documents/random_groups/$(groupId)
        ).data.memberIds;
    }
    
    /// Check if user is a member of a nearby group.
    function isNearbyGroupMember(groupId) {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/nearby_groups/$(groupId)/members/$(request.auth.uid));
    }
    
    /// Check if user is a member of ANY group type with the given groupId.
    /// Uses short-circuit evaluation: stops at the first match (1-3 Firestore reads).
    function isAnyGroupMember(groupId) {
      return isLocationGroupMember(groupId)
        || isRandomGroupMember(groupId)
        || isNearbyGroupMember(groupId);
    }
    
    // ============================================================
    // CHAT MEDIA FILES
    // ============================================================
    
    // Images in chat_media/images/{conversationId}/{uuid}.ext
    match /chat_media/images/{conversationId}/{fileName} {
      // Allow conversation participants to upload images
      allow write: if isConversationParticipant(conversationId)
        && isImage()
        && isValidSize(20) // 20MB max
        && resource == null; // Only allow creating new files, not overwriting
      
      // Allow reading images only to conversation participants
      allow read: if isConversationParticipant(conversationId);
    }
    
    // Audio files in chat_media/audio/{conversationId}/{uuid}.ext
    match /chat_media/audio/{conversationId}/{fileName} {
      // Allow conversation participants to upload audio (voice messages)
      allow write: if isConversationParticipant(conversationId)
        && isAudio()
        && isValidSize(50) // 50MB max for audio
        && resource == null;
      
      // Allow reading audio only to conversation participants
      allow read: if isConversationParticipant(conversationId);
    }
    
    // Documents in chat_media/documents/{conversationId}/{uuid}.ext
    match /chat_media/documents/{conversationId}/{fileName} {
      // Allow conversation participants to upload documents
      allow write: if isConversationParticipant(conversationId)
        && isDocument()
        && isValidSize(100) // 100MB max for documents
        && resource == null;
      
      // Allow reading documents only to conversation participants
      allow read: if isConversationParticipant(conversationId);
    }
    
    // Stickers in chat_media/stickers/{conversationId}/{uuid}.ext
    match /chat_media/stickers/{conversationId}/{fileName} {
      // Allow conversation participants to upload stickers (same as images)
      allow write: if isConversationParticipant(conversationId)
        && isImage()
        && isValidSize(5) // 5MB max for stickers
        && resource == null;
      
      // Allow reading stickers only to conversation participants
      allow read: if isConversationParticipant(conversationId);
    }
    
    // Videos in chat_media/videos/{conversationId}/{uuid}.ext
    match /chat_media/videos/{conversationId}/{fileName} {
      // Allow conversation participants to upload videos
      allow write: if isConversationParticipant(conversationId)
        && isVideo()
        && isValidSize(100) // 100MB max for videos
        && resource == null;
      
      // Allow reading videos only to conversation participants
      allow read: if isConversationParticipant(conversationId);
    }
    
    // ============================================================
    // GROUP MEDIA FILES (location_groups, random_groups, nearby_groups)
    // ============================================================
    
    // Group images in group_media/images/{groupId}/{uuid}.ext
    match /group_media/images/{groupId}/{fileName} {
      // Only group members can upload images
      allow write: if isAnyGroupMember(groupId)
        && isImage()
        && isValidSize(20) // 20MB max
        && resource == null;
      
      // Any authenticated user can read (ex-members retain access to viewed media)
      allow read: if isAuthenticated();
    }
    
    // Group audio in group_media/audio/{groupId}/{uuid}.ext
    match /group_media/audio/{groupId}/{fileName} {
      allow write: if isAnyGroupMember(groupId)
        && isAudio()
        && isValidSize(50) // 50MB max for audio
        && resource == null;
      
      allow read: if isAuthenticated();
    }
    
    // Group documents in group_media/documents/{groupId}/{uuid}.ext
    match /group_media/documents/{groupId}/{fileName} {
      allow write: if isAnyGroupMember(groupId)
        && isDocument()
        && isValidSize(100) // 100MB max for documents
        && resource == null;
      
      allow read: if isAuthenticated();
    }
    
    // Group videos in group_media/videos/{groupId}/{uuid}.ext
    match /group_media/videos/{groupId}/{fileName} {
      allow write: if isAnyGroupMember(groupId)
        && isVideo()
        && isValidSize(100) // 100MB max for videos
        && resource == null;
      
      allow read: if isAuthenticated();
    }
    
    // ============================================================
    // POST MEDIA FILES
    // ============================================================

    // Post images in post_media/images/{authorId}/{postId}/{uuid}.ext
    match /post_media/images/{authorId}/{postId}/{fileName} {
      // Only the author can upload images for their posts
      allow write: if isAuthenticated()
        && request.auth.uid == authorId
        && isImage()
        && isValidSize(20) // 20MB max
        && resource == null; // Only allow creating new files, not overwriting

      // Any authenticated user can read (visibility enforced at Firestore level)
      allow read: if isAuthenticated();
    }

    // Post videos in post_media/videos/{authorId}/{postId}/{uuid}.ext
    match /post_media/videos/{authorId}/{postId}/{fileName} {
      // Only the author can upload videos for their posts
      allow write: if isAuthenticated()
        && request.auth.uid == authorId
        && request.resource.contentType.matches('video/.*')
        && isValidSize(100) // 100MB max
        && resource == null;

      // Any authenticated user can read
      allow read: if isAuthenticated();
    }

    // Post video thumbnails in post_media/thumbnails/{authorId}/{postId}/{uuid}.ext
    match /post_media/thumbnails/{authorId}/{postId}/{fileName} {
      // Only the author can upload thumbnails for their posts
      allow write: if isAuthenticated()
        && request.auth.uid == authorId
        && isImage()
        && isValidSize(5) // 5MB max
        && resource == null;

      // Any authenticated user can read
      allow read: if isAuthenticated();
    }

    // ============================================================
    // VIDEO CHAT PROFILE PHOTOS
    // ============================================================

    // Profile photos in video_chat_photos/{userId}/profile.jpg
    match /video_chat_photos/{userId}/{fileName} {
      // Owner can upload/overwrite their own photo
      allow write: if isAuthenticated()
        && request.auth.uid == userId
        && isImage()
        && isValidSize(10); // 10MB max

      // Anyone authenticated can read (shown during calls)
      allow read: if isAuthenticated();

      // Owner can delete their photo
      allow delete: if isAuthenticated()
        && request.auth.uid == userId;
    }

    // ============================================================
    // LOCAL NEWS MEDIA
    // ============================================================

    // Local news images in local_news_media/images/{authorId}/{postId}/{uuid}.ext
    match /local_news_media/images/{authorId}/{postId}/{fileName} {
      allow write: if isAuthenticated()
        && request.auth.uid == authorId
        && isImage()
        && isValidSize(10) // 10MB max
        && resource == null;

      allow read: if isAuthenticated();
    }

    // Local news videos in local_news_media/videos/{authorId}/{postId}/{uuid}.ext
    match /local_news_media/videos/{authorId}/{postId}/{fileName} {
      allow write: if isAuthenticated()
        && request.auth.uid == authorId
        && request.resource.contentType.matches('video/.*')
        && isValidSize(50) // 50MB max
        && resource == null;

      allow read: if isAuthenticated();
    }

    // Local news reels in local_news_media/reels/{authorId}/{postId}/{uuid}.ext
    match /local_news_media/reels/{authorId}/{postId}/{fileName} {
      allow write: if isAuthenticated()
        && request.auth.uid == authorId
        && request.resource.contentType.matches('video/.*')
        && isValidSize(50) // 50MB max
        && resource == null;

      allow read: if isAuthenticated();
    }

    // Local news thumbnails in local_news_media/thumbnails/{authorId}/{postId}/{uuid}.ext
    match /local_news_media/thumbnails/{authorId}/{postId}/{fileName} {
      allow write: if isAuthenticated()
        && request.auth.uid == authorId
        && isImage()
        && isValidSize(5) // 5MB max
        && resource == null;

      allow read: if isAuthenticated();
    }

    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
